# Copy to .env and fill in. Never commit .env.
#
# Generate APP_KEY with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

APP_NAME="Agency"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_NAME=agency_session

# 'smtp' in production, 'log' for local development (writes storage/logs/mail.log).
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# MUST be an address on this site's own domain, with SPF and DKIM configured.
# A gmail.com From address sent through this server fails DMARC and will not arrive.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Agency"

# Where contact form notifications are delivered. Any inbox is fine.
MAIL_TO_ADDRESS=
MAIL_TO_NAME=

# Leave HSTS off until HTTPS is confirmed working on the live domain, then enable
# it starting at a low max-age. Turning it on too early makes the site unreachable
# over HTTP for the full max-age with no way to undo it from the server.
SECURITY_HSTS=false
SECURITY_HSTS_MAX_AGE=300
